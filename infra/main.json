{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "vmName": { "type": "string", "defaultValue": "hellfire-vm" },
    "adminUsername": { "type": "string", "defaultValue": "azureuser" },
    "adminPassword": { "type": "secureString" },
    "vmSize": { "type": "string", "defaultValue": "Standard_B1s", "allowedValues": ["Standard_B1s", "Standard_B2s"] },
    "repositoryUrl": { "type": "string" },
    "dnsLabel": { "type": "string", "defaultValue": "hellfire-azure-doom-felipinhobgtom" }
  },
  "variables": {
    "location": "[resourceGroup().location]",
    "storageName": "[toLower(concat('hellfire', uniqueString(resourceGroup().id)))]",
    "vnetName": "[concat(parameters('vmName'), '-vnet')]",
    "subnetName": "default",
    "nsgName": "[concat(parameters('vmName'), '-nsg')]",
    "publicIpName": "[concat(parameters('vmName'), '-pip')]",
    "nicName": "[concat(parameters('vmName'), '-nic')]"
  },
  "resources": [
    {
      "type": "Microsoft.Storage/storageAccounts", "apiVersion": "2023-05-01", "name": "[variables('storageName')]", "location": "[variables('location')]", "sku": { "name": "Standard_LRS" }, "kind": "StorageV2", "properties": { "minimumTlsVersion": "TLS1_2", "supportsHttpsTrafficOnly": true, "allowBlobPublicAccess": false, "accessTier": "Hot" }
    },
    {
      "type": "Microsoft.Network/networkSecurityGroups", "apiVersion": "2023-11-01", "name": "[variables('nsgName')]", "location": "[variables('location')]", "properties": { "securityRules": [{ "name": "http-in", "properties": { "priority": 100, "access": "Allow", "direction": "Inbound", "protocol": "Tcp", "sourceAddressPrefix": "Internet", "sourcePortRange": "*", "destinationAddressPrefix": "*", "destinationPortRange": "80" } }] }
    },
    {
      "type": "Microsoft.Network/virtualNetworks", "apiVersion": "2023-11-01", "name": "[variables('vnetName')]", "location": "[variables('location')]", "dependsOn": ["[resourceId('Microsoft.Network/networkSecurityGroups', variables('nsgName'))]"], "properties": { "addressSpace": { "addressPrefixes": ["10.10.0.0/16"] }, "subnets": [{ "name": "[variables('subnetName')]", "properties": { "addressPrefix": "10.10.1.0/24", "networkSecurityGroup": { "id": "[resourceId('Microsoft.Network/networkSecurityGroups', variables('nsgName'))]" } } }] }
    },
    {
      "type": "Microsoft.Network/publicIPAddresses", "apiVersion": "2023-11-01", "name": "[variables('publicIpName')]", "location": "[variables('location')]", "sku": { "name": "Standard" }, "properties": { "publicIPAllocationMethod": "Static", "publicIPAddressVersion": "IPv4", "dnsSettings": { "domainNameLabel": "[parameters('dnsLabel')]" } }
    },
    {
      "type": "Microsoft.Network/networkInterfaces", "apiVersion": "2023-11-01", "name": "[variables('nicName')]", "location": "[variables('location')]", "dependsOn": ["[resourceId('Microsoft.Network/virtualNetworks', variables('vnetName'))]", "[resourceId('Microsoft.Network/publicIPAddresses', variables('publicIpName'))]"], "properties": { "ipConfigurations": [{ "name": "ipconfig1", "properties": { "privateIPAllocationMethod": "Dynamic", "subnet": { "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', variables('vnetName'), variables('subnetName'))]" }, "publicIPAddress": { "id": "[resourceId('Microsoft.Network/publicIPAddresses', variables('publicIpName'))]" } } }] }
    },
    {
      "type": "Microsoft.Compute/virtualMachines", "apiVersion": "2023-09-01", "name": "[parameters('vmName')]", "location": "[variables('location')]", "dependsOn": ["[resourceId('Microsoft.Network/networkInterfaces', variables('nicName'))]", "[resourceId('Microsoft.Storage/storageAccounts', variables('storageName'))]"], "properties": {
        "hardwareProfile": { "vmSize": "[parameters('vmSize')]" },
        "osProfile": { "computerName": "[parameters('vmName')]", "adminUsername": "[parameters('adminUsername')]", "adminPassword": "[parameters('adminPassword')]", "linuxConfiguration": { "disablePasswordAuthentication": false, "provisionVMAgent": true }, "customData": "[base64(concat('#cloud-config\npackage_update: true\npackages:\n  - docker.io\n  - git\nruncmd:\n  - [ sh, -c, \"systemctl enable --now docker\" ]\n  - [ sh, -c, \"git clone --recurse-submodules ', parameters('repositoryUrl'), ' /opt/hellfire\" ]\n  - [ sh, -c, \"mkdir -p /opt/hellfire/data && chown 10001:10001 /opt/hellfire/data\" ]\n  - [ sh, -c, \"docker build -t hellfire /opt/hellfire\" ]\n  - [ sh, -c, \"docker run -d --restart unless-stopped --name hellfire -p 80:8000 -v /opt/hellfire/data:/data hellfire\" ]\n'))]" },
        "storageProfile": { "imageReference": { "publisher": "Canonical", "offer": "0001-com-ubuntu-server-jammy", "sku": "22_04-lts-gen2", "version": "latest" }, "osDisk": { "name": "[concat(parameters('vmName'), '-osdisk')]", "createOption": "FromImage", "managedDisk": { "storageAccountType": "StandardSSD_LRS" }, "diskSizeGB": 30 } },
        "networkProfile": { "networkInterfaces": [{ "id": "[resourceId('Microsoft.Network/networkInterfaces', variables('nicName'))]" }] },
        "diagnosticsProfile": { "bootDiagnostics": { "enabled": true, "storageUri": "[reference(resourceId('Microsoft.Storage/storageAccounts', variables('storageName')), '2023-05-01').primaryEndpoints.blob]" } }
      }
    }
  ],
  "outputs": {
    "websiteUrl": { "type": "string", "value": "[concat('http://', reference(resourceId('Microsoft.Network/publicIPAddresses', variables('publicIpName')), '2023-11-01').dnsSettings.fqdn)]" },
    "dnsFqdn": { "type": "string", "value": "[reference(resourceId('Microsoft.Network/publicIPAddresses', variables('publicIpName')), '2023-11-01').dnsSettings.fqdn]" },
    "publicIp": { "type": "string", "value": "[reference(resourceId('Microsoft.Network/publicIPAddresses', variables('publicIpName')), '2023-11-01').ipAddress]" },
    "storageAccount": { "type": "string", "value": "[variables('storageName')]" },
    "vmSize": { "type": "string", "value": "[parameters('vmSize')]" }
  }
}
